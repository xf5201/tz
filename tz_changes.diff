 /**
+ * 判断表中是否存在某列
+ * @param {Database} db
+ * @param {string} table
+ * @param {string} column
+ * @returns {boolean}
+ */
+function columnExists(db, table, column) {
+  try {
+    const cols = db.prepare(`PRAGMA table_info(${table})`).all();
+    return cols.some((c) => c.name === column);
+  } catch (_) {
+    return false;
+  }
+}
