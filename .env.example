# ── 必填 ──
# Telegram Bot（@BotFather 创建）
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram API 凭证（my.telegram.org → API development tools）
# 兼容两种变量名：TG_API_ID/API_ID、TG_API_HASH/API_HASH
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# ── 可选（有默认值）──
# SQLite 数据库文件路径
DATABASE_PATH=./data/database.db
# 日志级别 debug/info/warn/error
LOG_LEVEL=info
# 日志目录
LOG_DIR=./logs
# 运行环境 production / development
NODE_ENV=production
# 消息流水保留天数（定时清理）
MESSAGE_RETENTION_DAYS=90
# 动作记录保留天数（定时清理）
ACTION_RETENTION_DAYS=180
# 骰子开奖轮询间隔（毫秒）。部分群组服务器不推送实时更新，靠轮询兜底
DICE_POLL_INTERVAL_MS=5000
