# ── 必填 ──
# Telegram Bot（@BotFather 创建）
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram API 凭证（my.telegram.org → API development tools）
# 兼容两种变量名：TG_API_ID/API_ID、TG_API_HASH/API_HASH
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# ── 可选（有默认值）──
# SQLite 数据库文件路径
DATABASE_PATH=./data/database.db
# 日志级别 debug/info/warn/error
LOG_LEVEL=info
# 日志目录
LOG_DIR=./logs
# 运行环境 production / development
NODE_ENV=production
# 消息流水保留天数（定时清理）
MESSAGE_RETENTION_DAYS=90
# 动作记录保留天数（定时清理）
ACTION_RETENTION_DAYS=180
# 骰子开奖轮询间隔（毫秒）。部分群组服务器不推送实时更新，靠轮询兜底
DICE_POLL_INTERVAL_MS=5000
# 开奖池广播模式：true（默认）= 每群 1 个代表账号拉取 → 广播给全部监听账号（推荐）
# false = 回退旧版逐账号轮询（每个监听账号各自拉取，100号场景拉取量约 20 倍）
LOTTERY_POOL_ENABLED=true
# 开奖池跨群拉取并发上限（不同群并行，同群内串行广播保开奖/结算时序）
LOTTERY_CONCURRENCY=8
# 开奖池拓扑目录刷新周期（毫秒）：重建「群 → 代表账号 + 监听账号」映射
LOTTERY_CATALOG_REFRESH_MS=30000
# 池分片：按群哈希分片，1 = 单池全量；多进程横向扩容时 COUNT=总池数、INDEX=各进程序号
LOTTERY_SHARD_COUNT=1
LOTTERY_SHARD_INDEX=0
# 日志是否打印到终端：false（默认，只写日志文件，终端干净）/ true（恢复全部终端输出）
LOG_CONSOLE=false
# 余额停注门槛（默认 0）：当前余额 <= 该值时全局停注，所有规则不再下注
# 余额恢复（充值）后自动继续，无需重新启用规则
BALANCE_FLOOR=0
# 本账号在群里下注时显示的昵称（可选，如「可乐」）
# 余额播报归属的二次校验：群里人人下注都会收到余额播报，
# 系统默认靠「回复的是不是自己那条下注消息」判定；配了昵称后还要求播报里出现该昵称，
# 双重确认，确保不会把别人的余额记到自己账上。留空 = 不校验昵称
BALANCE_NICKNAME=
# ── TG 客户端设备指纹（防风控，GramJS Issue #452）──
# 必须与登录/重连保持一致，缺失或跳变会触发 Telegram 吊销全设备会话
# TG_DEVICE_MODEL=Redmi 23078RKD5C   # 真机：Redmi K60 Ultra
# TG_SYSTEM_VERSION=SDK 36           # Android 16
# TG_APP_VERSION=12.10.1             # 与本机官方 TG 版本一致
# TG_LANG_CODE=zh
# ── 五数定位胆玩法（SPEC_FIVE，mode=1 规则）──
# 定位胆赔付倍率（含本金）：开奖数命中号码组时，单数返还 = 该数注额 × 5.8
# 一注 = 5 个数各一份，总投入 5A：赢 = 5.8A − 5A = +0.8A；输 = −5A
DICE_SPEC_PAYOUT=5.8
