# ── 必填 ──
# Telegram Bot（@BotFather 创建）
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram API 凭证（my.telegram.org → API development tools）
# 兼容两种变量名：TG_API_ID/API_ID、TG_API_HASH/API_HASH
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# ── 可选（有默认值）──
# SQLite 数据库文件路径
DATABASE_PATH=./data/database.db
# 日志级别 debug/info/warn/error
LOG_LEVEL=info
# 日志目录
LOG_DIR=./logs
# 运行环境 production / development
NODE_ENV=production
# 消息流水保留天数（定时清理）
MESSAGE_RETENTION_DAYS=90
# 动作记录保留天数（定时清理）
ACTION_RETENTION_DAYS=180
# 骰子开奖轮询间隔（毫秒）。部分群组服务器不推送实时更新，靠轮询兜底
DICE_POLL_INTERVAL_MS=5000
# 日志是否打印到终端：false（默认，只写日志文件，终端干净）/ true（恢复全部终端输出）
LOG_CONSOLE=false
# 余额停注门槛（默认 0）：当前余额 <= 该值时全局停注，所有规则不再下注
# 余额恢复（充值）后自动继续，无需重新启用规则
BALANCE_FLOOR=0
# 本账号在群里下注时显示的昵称（可选，如「可乐」）
# 余额播报归属的二次校验：群里人人下注都会收到余额播报，
# 系统默认靠「回复的是不是自己那条下注消息」判定；配了昵称后还要求播报里出现该昵称，
# 双重确认，确保不会把别人的余额记到自己账上。留空 = 不校验昵称
BALANCE_NICKNAME=
